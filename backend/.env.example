# INTERVIEWX - Environment Variables Configuration
# Copy this file to .env and customize as needed.

# Application Settings
APP_NAME=INTERVIEWX – AI Interview Simulator
DEBUG=True
HOST=127.0.0.1
PORT=8000

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./interviewx.db

# AI / LLM Configuration (To be integrated in Phase 4)
# When ready for Gemini integration, set GEMINI_API_KEY and set LLM_ENABLED=true
LLM_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here


